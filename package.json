{
  "name": "testcontainers-tigerbeetle",
  "version": "0.0.5",
  "description": "TigerBeetle module for Testcontainers (Node.js)",
  "license": "MIT",
  "author": "clauRamirez <clau.rjimenez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauRamirez/testcontainers-tigerbeetle.git"
  },
  "homepage": "https://github.com/clauRamirez/testcontainers-tigerbeetle#readme",
  "bugs": {
    "url": "https://github.com/clauRamirez/testcontainers-tigerbeetle/issues"
  },
  "keywords": [
    "tigerbeetle",
    "testcontainers",
    "docker",
    "testing",
    "database"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . && eslint . --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format && npm run typecheck"
  },
  "dependencies": {
    "testcontainers": "^12.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "simple-git-hooks": "^2.13.1",
    "tigerbeetle-node": "0.17.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
